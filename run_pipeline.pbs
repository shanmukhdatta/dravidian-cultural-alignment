#!/bin/bash
# ==============================================================================
# NIT Jalandhar HPC (H100) - Dravidian cultural drift pipeline
# Fixes vs run_pipeline.pbs.orig:
#  - HF_HOME /Data/... (permission denied) -> /Data3/it_FA0571/.cache/huggingface
#  - conda activate -> PATH export of dravidian_env (activate fails silently in PBS)
#  - HF_TOKEN read from ~/.bashrc (not stored in this file)
#  - inference run one model at a time, deleting that model's HF cache afterwards
#    (/Data3 has ~50 GB free; 5 models are ~80 GB)
#  - judge step skipped if OPENAI_API_KEY is not set
# ==============================================================================

#PBS -N dravidian_drift
#PBS -q workq
#PBS -l select=1:ncpus=32:ngpus=1
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o output_pipeline.log

set -e
set -o pipefail

cd "$PBS_O_WORKDIR"
echo "======================================================================"
echo "Job ID             : $PBS_JOBID"
echo "Compute Node       : $(hostname)"
echo "Working Directory  : $(pwd)"
echo "Start Time         : $(date)"
echo "======================================================================"

export HF_HOME="/Data3/it_FA0571/.cache/huggingface"
mkdir -p "$HF_HOME"
echo "Hugging Face Cache : $HF_HOME"

export PYTHONNOUSERSITE=1
export PATH=/Data3/it_FA0571/.conda/envs/dravidian_env/bin:$PATH
export PYTHONUNBUFFERED=1
export HF_HUB_ENABLE_HF_TRANSFER=0
export CUDA_VISIBLE_DEVICES=6
echo "Python: $(which python3)"

echo "Active GPU Devices Check:"
nvidia-smi -L || true
echo "----------------------------------------------------------------------"

eval "$(grep -m1 '^export HF_TOKEN=' /Data3/it_FA0571/.bashrc || true)"
export HF_TOKEN="${HF_TOKEN:-}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-}"

# ---- Step 1: inference, one model at a time --------------------------------
echo ""
echo ">>> [1/3] STARTING STEP 1: Model Inference on H100 GPU <<<"
for M in llama31_8b:meta-llama--Llama-3.1-8B-Instruct          gemma2_9b:google--gemma-2-9b-it          gemma3_12b:google--gemma-3-12b-it          qwen3_8b:Qwen--Qwen3-8B          sarvam_m:sarvamai--sarvam-m; do
    NAME=${M%%:*}; CACHE=${M##*:}
    echo "--- model $NAME | disk free: $(df -h /Data3 | tail -1 | awk '{print $4}') | $(date) ---"
    python3 -u code/01_run_inference.py --models "$NAME"
    rm -rf "$HF_HOME/hub/models--$CACHE"   # free disk before next model
done
# final pass: every checkpoint complete -> no model loads, just merges raw_responses.json
python3 -u code/01_run_inference.py
echo ">>> [1/3] STEP 1 FINISHED: raw_responses.json generated <<<"

# ---- Step 2: GPT-4o judge (needs OPENAI_API_KEY) ---------------------------
echo ""
echo ">>> [2/3] STARTING STEP 2: GPT-4o Cultural Stance Judge <<<"
if [ -n "$OPENAI_API_KEY" ]; then
    python3 -u code/02_judge_responses.py
    echo ">>> [2/3] STEP 2 FINISHED: judge_scores.json generated <<<"
else
    echo ">>> [2/3] SKIPPED: OPENAI_API_KEY not set - run code/02_judge_responses.py later <<<"
fi

# ---- Step 3: LaBSE semantic drift ------------------------------------------
echo ""
echo ">>> [3/3] STARTING STEP 3: LaBSE Semantic Drift Calculation <<<"
python3 -u code/03_embed_distance.py
echo ">>> [3/3] STEP 3 FINISHED: embed_distances.json generated <<<"

echo ""
echo "======================================================================"
echo "PIPELINE COMPLETED"
echo "End Time: $(date)"
echo "======================================================================"
